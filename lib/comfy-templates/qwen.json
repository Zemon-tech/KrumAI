{
  "1": {
    "class_type": "UNETLoader",
    "_meta": { "title": "Load Diffusion Model" },
    "inputs": {
      "unet_name": "qwen_image_edit_bf16.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": { "title": "Load CLIP" },
    "inputs": {
      "clip_name": "qwen_image_edit_2511_bf16.safetensors",
      "type": "qwen_image",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": { "title": "Load VAE" },
    "inputs": {
      "vae_name": "qwen_image_vae.safetensors"
    }
  },
  "4": {
    "class_type": "LoadImage",
    "_meta": { "title": "Load Input Image" },
    "inputs": {
      "image": "your_image.png",
      "upload": "image"
    }
  },
  "5": {
    "class_type": "ImageScaleToTotalPixels",
    "_meta": { "title": "Scale to ~1MP" },
    "inputs": {
      "image": ["4", 0],
      "upscale_method": "lanczos",
      "megapixels": 1.0
    }
  },
  "6": {
    "class_type": "ModelSamplingAuraFlow",
    "_meta": { "title": "Model Sampling AuraFlow" },
    "inputs": {
      "model": ["1", 0],
      "shift": 3.0
    }
  },
  "7": {
    "class_type": "TextEncodeQwenImageEdit",
    "_meta": { "title": "Encode Prompt + Image" },
    "inputs": {
      "clip": ["2", 0],
      "vae": ["3", 0],
      "image": ["5", 0],
      "prompt": "Change the background to a sunset beach"
    }
  },
  "8": {
    "class_type": "CFGNorm",
    "_meta": { "title": "CFG Norm" },
    "inputs": {
      "model": ["6", 0],
      "strength": 1.0
    }
  },
  "9": {
    "class_type": "VAEEncode",
    "_meta": { "title": "VAE Encode" },
    "inputs": {
      "pixels": ["5", 0],
      "vae": ["3", 0]
    }
  },
  "10": {
    "class_type": "KSampler",
    "_meta": { "title": "KSampler" },
    "inputs": {
      "model": ["8", 0],
      "positive": ["7", 0],
      "negative": ["7", 0],
      "latent_image": ["9", 0],
      "seed": 123,
      "steps": 40,
      "cfg": 4.0,
      "sampler_name": "euler",
      "scheduler": "beta",
      "denoise": 1.0
    }
  },
  "11": {
    "class_type": "VAEDecode",
    "_meta": { "title": "VAE Decode" },
    "inputs": {
      "samples": ["10", 0],
      "vae": ["3", 0]
    }
  },
  "12": {
    "class_type": "SaveImage",
    "_meta": { "title": "Save Image" },
    "inputs": {
      "images": ["11", 0],
      "filename_prefix": "qwen_edit_output"
    }
  }
}
